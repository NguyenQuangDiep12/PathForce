<Window x:Class="PathForge.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:PathForge.Desktop.Views"
        xmlns:vm="clr-namespace:PathForge.Desktop.ViewModels"
        Title="PathForge" Height="760" Width="1240" MinHeight="620" MinWidth="980"
        WindowStartupLocation="CenterScreen" Background="{StaticResource CanvasBrush}" Closing="Window_Closing">
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}"><views:DashboardView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:ProblemsViewModel}"><views:ProblemsView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:WorkSessionViewModel}"><views:WorkSessionView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:HistoryViewModel}"><views:HistoryView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:KnowledgeDocumentsViewModel}"><views:KnowledgeDocumentsView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:PlaceholderViewModel}">
            <StackPanel Margin="52,44" MaxWidth="720">
                <TextBlock Text="{Binding Title}" FontSize="30" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" />
                <TextBlock Text="{Binding Message}" Margin="0,14,0,0" FontSize="16" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" />
            </StackPanel>
        </DataTemplate>
        <Style x:Key="NavigationButtonStyle" TargetType="Button">
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="16,12" />
            <Setter Property="Margin" Value="0,3" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#D8DED9" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}"><ContentPresenter /></Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#30483F" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="224" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="#202D28">
            <DockPanel LastChildFill="True" Margin="18,22">
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="PathForge" FontSize="24" FontWeight="Bold" Foreground="White" Margin="10,2,0,30" />
                    <Button Content="Tổng quan" Command="{Binding ShowDashboardCommand}" Style="{StaticResource NavigationButtonStyle}" />
                    <Button Content="Bài toán" Command="{Binding ShowProblemsCommand}" Style="{StaticResource NavigationButtonStyle}" />
                    <Button Content="Thực hiện" Command="{Binding ShowPracticeCommand}" Style="{StaticResource NavigationButtonStyle}" />
                    <Button Content="Lịch sử" Command="{Binding ShowHistoryCommand}" Style="{StaticResource NavigationButtonStyle}" />
                    <Button Content="Tài liệu kiến thức" Command="{Binding ShowKnowledgeDocumentsCommand}" Style="{StaticResource NavigationButtonStyle}" />
                </StackPanel>
                <TextBlock DockPanel.Dock="Bottom" Text="Bản MVP · lưu trên máy này" Foreground="#9EAAA3" FontSize="11" Margin="10,20,0,2" />
            </DockPanel>
        </Border>
        <ContentControl Grid.Column="1" Content="{Binding CurrentViewModel}" />
    </Grid>
</Window>
