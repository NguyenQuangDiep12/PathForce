<UserControl x:Class="PathForge.Desktop.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="52,40" MaxWidth="960" HorizontalAlignment="Left">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="24" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel>
                <TextBlock Text="Tổng quan" FontSize="30" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" />
                <TextBlock Text="Bắt đầu từ việc quan trọng nhất cần giải quyết." Margin="0,8,0,0" FontSize="15" Foreground="{StaticResource MutedBrush}" />
            </StackPanel>
            <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="12" Padding="28">
                <Grid>
                    <StackPanel Visibility="{Binding HasProblem, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="BÀI TOÁN ĐANG THEO DÕI" FontSize="11" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" />
                        <TextBlock Text="{Binding CurrentProblem.Title}" Margin="0,12,0,0" FontSize="23" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding CurrentProblem.Goal}" Margin="0,9,0,0" FontSize="15" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                        <Border Background="#EEF3EF" CornerRadius="14" Padding="12,5" HorizontalAlignment="Left" Margin="0,18,0,0">
                            <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" />
                        </Border>
                        <TextBlock Text="{Binding CurrentProblem.NextAction}" Margin="0,22,0,0" FontSize="14" TextWrapping="Wrap" Foreground="{StaticResource InkBrush}" />
                        <Border Background="#F7F8F5" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="8" Padding="13" Margin="0,18,0,0"
                                Visibility="{Binding HasOpenSession, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Left">
                                    <TextBlock Text="{Binding OpenSessionText}" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" />
                                    <TextBlock Text="{Binding OpenSession.TaskTitle}" Margin="0,3,0,0" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                                <Button Content="Mở phiên" Command="{Binding OpenSessionCommand}" Style="{StaticResource SecondaryButtonStyle}" DockPanel.Dock="Right" Margin="12,0,0,0" />
                            </DockPanel>
                        </Border>
                        <Border Background="#F7F8F5" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="8" Padding="13" Margin="0,10,0,0"
                                Visibility="{Binding HasRecentReport, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Left">
                                    <TextBlock Text="Kết quả phiên gần nhất" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" />
                                    <TextBlock Text="{Binding RecentReportSummary}" Margin="0,3,0,0" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                                <Button Content="Xem báo cáo" Command="{Binding OpenRecentReportCommand}" Style="{StaticResource SecondaryButtonStyle}" DockPanel.Dock="Right" Margin="12,0,0,0" />
                            </DockPanel>
                        </Border>
                        <Button Content="Mở bài toán" Command="{Binding OpenProblemCommand}" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Left" Margin="0,24,0,0" />
                    </StackPanel>
                    <StackPanel Visibility="{Binding HasProblem, Converter={StaticResource InverseVisibilityConverter}}">
                        <TextBlock Text="Chưa có bài toán nào" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" />
                        <TextBlock Text="Tạo một bài toán với mục tiêu rõ ràng để bắt đầu ghi lại quá trình giải quyết." Margin="0,10,0,0" FontSize="15" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" />
                        <Button Content="Tạo bài toán" Command="{Binding CreateProblemCommand}" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Left" Margin="0,22,0,0" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
