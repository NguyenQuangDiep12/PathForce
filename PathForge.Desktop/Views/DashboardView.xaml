<UserControl x:Class="PathForge.Desktop.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="40,34" MaxWidth="1120" HorizontalAlignment="Center">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="26" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <DockPanel LastChildFill="False">
                <StackPanel>
                    <TextBlock Text="Tổng quan" FontSize="30" FontWeight="SemiBold" />
                    <TextBlock Text="Một nơi để chọn việc quan trọng và theo dõi tiến độ." Margin="0,5,0,0" FontSize="15" Foreground="{StaticResource MutedBrush}" />
                </StackPanel>
                <Button Content="＋  Tạo bài toán" Command="{Binding CreateProblemCommand}" Style="{StaticResource PrimaryButtonStyle}"
                        DockPanel.Dock="Right" VerticalAlignment="Center" Margin="18,0,0,0"
                        Visibility="{Binding HasProblem, Converter={StaticResource InverseVisibilityConverter}}" />
                <Button Content="Tiếp tục thực hiện" Command="{Binding ContinueWorkCommand}" Style="{StaticResource PrimaryButtonStyle}"
                        DockPanel.Dock="Right" VerticalAlignment="Center" Margin="18,0,0,0"
                        Visibility="{Binding HasProblem, Converter={StaticResource BooleanToVisibilityConverter}}" />
            </DockPanel>

            <Grid Grid.Row="2" Visibility="{Binding HasProblem, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.7*" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="14" Padding="30">
                    <StackPanel>
                        <DockPanel>
                            <TextBlock Text="BÀI TOÁN ĐANG THEO DÕI" FontSize="11" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" />
                            <Border Background="{StaticResource AccentSoftBrush}" CornerRadius="12" Padding="10,4" DockPanel.Dock="Right">
                                <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" FontSize="12" />
                            </Border>
                        </DockPanel>
                        <TextBlock Text="{Binding CurrentProblem.Title}" Margin="0,22,0,0" FontSize="27" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding CurrentProblem.Goal}" Margin="0,10,0,0" FontSize="15" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                        <Border Height="1" Background="{StaticResource LineBrush}" Margin="0,26,0,22" />
                        <TextBlock Text="BƯỚC TIẾP THEO" FontSize="11" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" />
                        <TextBlock Text="{Binding NextActionText}" FontSize="16" Margin="0,8,0,0" TextWrapping="Wrap" />
                        <WrapPanel Margin="0,26,0,0">
                            <Button Content="Mở bài toán" Command="{Binding OpenProblemCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,9,8" />
                            <Button Content="Xem báo cáo gần nhất" Command="{Binding OpenRecentReportCommand}" Style="{StaticResource SecondaryButtonStyle}"
                                    Margin="0,0,9,8" Visibility="{Binding HasRecentReport, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <StackPanel Grid.Column="2">
                    <Border Background="{StaticResource AccentBrush}" CornerRadius="14" Padding="20"
                            Visibility="{Binding HasOpenSession, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel>
                            <TextBlock Text="PHIÊN ĐANG MỞ" FontSize="11" FontWeight="Bold" Foreground="#CDE3D8" />
                            <TextBlock Text="{Binding OpenSessionText}" FontSize="19" FontWeight="SemiBold" Foreground="White" Margin="0,10,0,0" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding OpenSession.TaskTitle}" FontSize="14" Foreground="#E8F1EC" Margin="0,5,0,0" TextWrapping="Wrap" />
                            <Button Content="Quay lại phiên" Command="{Binding OpenSessionCommand}" Background="White" Foreground="{StaticResource AccentBrush}"
                                    Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Left" Margin="0,18,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="14" Padding="20" Margin="0,14,0,0"
                            Visibility="{Binding HasRecentReport, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel>
                            <TextBlock Text="KẾT QUẢ PHIÊN GẦN NHẤT" FontSize="11" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" />
                            <TextBlock Text="{Binding RecentReportSummary}" FontSize="14" Margin="0,10,0,0" TextWrapping="Wrap" />
                            <Button Content="Mở báo cáo" Command="{Binding OpenRecentReportCommand}" Style="{StaticResource SecondaryButtonStyle}"
                                    HorizontalAlignment="Left" Margin="0,16,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Background="#EAF1ED" CornerRadius="14" Padding="20" Margin="0,14,0,0"
                            Visibility="{Binding HasOpenSession, Converter={StaticResource InverseVisibilityConverter}}">
                        <StackPanel>
                            <TextBlock Text="Giữ nhịp tiến độ" FontSize="17" FontWeight="SemiBold" />
                            <TextBlock Text="Chia bài toán thành một nhiệm vụ nhỏ, tập trung xử lý rồi ghi lại kết quả." Margin="0,7,0,0"
                                       Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="14" Padding="34"
                    Visibility="{Binding HasProblem, Converter={StaticResource InverseVisibilityConverter}}">
                <StackPanel MaxWidth="530" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border Width="54" Height="54" CornerRadius="16" Background="{StaticResource AccentSoftBrush}" HorizontalAlignment="Center">
                        <TextBlock Text="◎" FontSize="30" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="Bắt đầu từ một bài toán" FontSize="24" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,18,0,0" />
                    <TextBlock Text="Ghi lại điều bạn muốn giải quyết, xác định kết quả cần đạt rồi chia thành bước nhỏ." Foreground="{StaticResource MutedBrush}"
                               FontSize="15" TextWrapping="Wrap" TextAlignment="Center" Margin="0,8,0,0" />
                    <Button Content="＋  Tạo bài toán đầu tiên" Command="{Binding CreateProblemCommand}" Style="{StaticResource PrimaryButtonStyle}"
                            HorizontalAlignment="Center" Margin="0,20,0,0" />
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
