<UserControl x:Class="PathForge.Desktop.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="34,30">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="18" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="Lịch sử" FontSize="28" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" />
            <TextBlock Text="Tìm lại bài toán, nhiệm vụ, báo cáo và ảnh minh chứng." Margin="0,5,0,0" Foreground="{StaticResource MutedBrush}" />
        </StackPanel>
        <Grid Grid.Row="2">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="12" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <DockPanel LastChildFill="False">
                <Button Content="Tìm kiếm" Command="{Binding SearchCommand}" Style="{StaticResource PrimaryButtonStyle}" DockPanel.Dock="Right" Margin="10,0,0,0" />
                <TextBox Text="{Binding Keyword, UpdateSourceTrigger=PropertyChanged}" Padding="11" BorderBrush="{StaticResource LineBrush}" VerticalContentAlignment="Center" />
            </DockPanel>
            <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="10" Padding="15">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Bottom" LastChildFill="False" Margin="0,10,0,0">
                        <TextBlock Text="{Binding Message}" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                        <Button Content="Mở nội dung liên quan" Command="{Binding OpenCommand}" Style="{StaticResource SecondaryButtonStyle}" DockPanel.Dock="Right" />
                    </DockPanel>
                    <ListBox ItemsSource="{Binding Results}" SelectedItem="{Binding SelectedResult, Mode=TwoWay}" BorderThickness="0" Background="Transparent">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#F7F8F5" CornerRadius="7" Padding="13" Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="130" /><ColumnDefinition Width="*" /><ColumnDefinition Width="145" /></Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding KindText}" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" />
                                        <StackPanel Grid.Column="1" Margin="12,0">
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding Context}" Margin="0,4,0,0" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" MaxHeight="44" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{Binding DateText}" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Right" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
