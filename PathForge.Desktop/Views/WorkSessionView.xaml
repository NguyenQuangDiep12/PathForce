<UserControl x:Class="PathForge.Desktop.Views.WorkSessionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="38,30" MaxWidth="1080" HorizontalAlignment="Center">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="20" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <StackPanel>
                <TextBlock Text="Thực hiện" FontSize="29" FontWeight="SemiBold" />
                <TextBlock Text="Mỗi phiên tập trung vào một nhiệm vụ chính." Margin="0,6,0,0" Foreground="{StaticResource MutedBrush}" />
            </StackPanel>
            <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="14" Padding="28">
                <Grid>
                    <StackPanel Visibility="{Binding IsIdle, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="Bắt đầu một phiên" FontSize="21" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" />
                        <TextBlock Text="Bài toán" Margin="0,18,0,6" FontWeight="SemiBold" />
                        <ComboBox ItemsSource="{Binding Problems}" SelectedItem="{Binding SelectedProblem}" Padding="7" DisplayMemberPath="Title" />
                        <TextBlock Text="Mục trong phạm vi (tùy chọn)" Margin="0,14,0,6" FontWeight="SemiBold" />
                        <ComboBox ItemsSource="{Binding ScopeItems}" SelectedItem="{Binding SelectedScopeItem}" Padding="7" DisplayMemberPath="Title" />
                        <TextBlock Text="Nhiệm vụ chính" Margin="0,14,0,6" FontWeight="SemiBold" />
                        <TextBox Text="{Binding TaskTitle, UpdateSourceTrigger=LostFocus}" Padding="10" MinHeight="50" AcceptsReturn="True" TextWrapping="Wrap" BorderBrush="{StaticResource LineBrush}" />
                        <TextBlock Text="Thời lượng gợi ý" Margin="0,14,0,6" FontWeight="SemiBold" />
                        <ComboBox ItemsSource="{Binding Durations}" SelectedItem="{Binding SelectedDuration}" Padding="7" HorizontalAlignment="Left" MinWidth="150" />
                        <TextBlock Text="Timer chỉ hỗ trợ tập trung. Hết thời gian không tự kết thúc phiên." Margin="0,12,0,0" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                        <Button Content="Bắt đầu phiên" Command="{Binding StartCommand}" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Left" Margin="0,20,0,0" />
                    </StackPanel>

                    <StackPanel Visibility="{Binding IsIdle, Converter={StaticResource InverseVisibilityConverter}}">
                        <TextBlock Text="{Binding Session.ProblemTitle}" FontSize="14" Foreground="{StaticResource MutedBrush}" />
                        <TextBlock Text="{Binding Session.ScopeContext}" Margin="0,4,0,0" FontSize="12" Foreground="{StaticResource MutedBrush}" />
                        <TextBlock Text="{Binding Session.TaskTitle}" FontSize="23" FontWeight="SemiBold" Margin="0,6,0,0" Foreground="{StaticResource InkBrush}" TextWrapping="Wrap"
                                   Visibility="{Binding CanUpdateTask, Converter={StaticResource InverseVisibilityConverter}}" />
                        <TextBox Text="{Binding TaskTitle, UpdateSourceTrigger=LostFocus}" FontSize="20" FontWeight="SemiBold" Margin="0,8,0,0" Padding="9"
                                 TextWrapping="Wrap" AcceptsReturn="True" BorderBrush="{StaticResource LineBrush}"
                                 Visibility="{Binding CanUpdateTask, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <TextBlock Text="{Binding SessionStatusText}" Margin="0,10,0,0" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" />
                        <WrapPanel Margin="0,10,0,0">
                            <Button Content="Mở bài toán liên quan" Command="{Binding OpenProblemCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,6" />
                            <Button Content="Mở mục phạm vi liên quan" Command="{Binding OpenScopeItemCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,6" />
                        </WrapPanel>
                        <StackPanel Visibility="{Binding IsReportVisible, Converter={StaticResource InverseVisibilityConverter}}" Margin="0,24,0,0">
                            <TextBlock Text="Thời gian làm việc" FontSize="12" Foreground="{StaticResource MutedBrush}" />
                            <TextBlock Text="{Binding ElapsedText}" FontSize="42" FontWeight="Light" Foreground="{StaticResource InkBrush}" Margin="0,4,0,12" />
                            <WrapPanel>
                                <Button Content="Tạm dừng" Command="{Binding PauseCommand}" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,8"
                                        Visibility="{Binding IsRunning, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                <Button Content="Tiếp tục" Command="{Binding ResumeCommand}" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,8"
                                        Visibility="{Binding IsPaused, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                <Button Content="Kết thúc và ghi báo cáo" Command="{Binding EndCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,8" />
                                <Button Content="Bỏ phiên" Command="{Binding AbandonCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,8" />
                            </WrapPanel>
                            <Button Content="Lưu nhiệm vụ đã điều chỉnh" Command="{Binding SaveTaskTitleCommand}" Style="{StaticResource SecondaryButtonStyle}"
                                    HorizontalAlignment="Left" Margin="0,4,0,10" Visibility="{Binding CanUpdateTask, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <Button Content="＋ Ghi nhanh chủ đề phát sinh" Command="{Binding ShowQuickScopeCommand}" Style="{StaticResource SecondaryButtonStyle}"
                                    HorizontalAlignment="Left" Margin="0,6,0,8" Visibility="{Binding CanRecordQuickScope, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <Border Background="#F7F8F5" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,4,0,0"
                                    Visibility="{Binding IsQuickScopeFormVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <StackPanel>
                                    <TextBlock Text="Chủ đề hoặc vấn đề cần ghi nhận" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" />
                                    <TextBox Text="{Binding QuickScopeTitle, UpdateSourceTrigger=LostFocus}" Padding="9" Margin="0,6,0,0" BorderBrush="{StaticResource LineBrush}" />
                                    <TextBlock Text="Lý do hoặc ngữ cảnh (tùy chọn)" Margin="0,10,0,5" Foreground="{StaticResource MutedBrush}" />
                                    <TextBox Text="{Binding QuickScopeReason, UpdateSourceTrigger=LostFocus}" Padding="9" MinHeight="48" AcceptsReturn="True" TextWrapping="Wrap" BorderBrush="{StaticResource LineBrush}" />
                                    <TextBlock Text="Trạng thái do bạn chọn" Margin="0,10,0,5" Foreground="{StaticResource MutedBrush}" />
                                    <ComboBox ItemsSource="{Binding QuickScopeStatuses}" DisplayMemberPath="Value" SelectedValuePath="Key" SelectedValue="{Binding QuickScopeStatus}" Padding="7" HorizontalAlignment="Left" MinWidth="180" />
                                    <WrapPanel Margin="0,12,0,0">
                                        <Button Content="Lưu chủ đề" Command="{Binding SaveQuickScopeCommand}" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,0" />
                                        <Button Content="Hủy" Command="{Binding CancelQuickScopeCommand}" Style="{StaticResource SecondaryButtonStyle}" />
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        <StackPanel Visibility="{Binding IsReportVisible, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,24,0,0">
                            <TextBlock Text="Báo cáo phiên" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" />
                            <TextBlock Text="Đã làm gì?" Margin="0,14,0,5" FontWeight="SemiBold" />
                            <TextBox Text="{Binding WhatWasDone, UpdateSourceTrigger=LostFocus}" Padding="9" MinHeight="52" AcceptsReturn="True" TextWrapping="Wrap" BorderBrush="{StaticResource LineBrush}" />
                            <TextBlock Text="Kết quả đạt được" Margin="0,12,0,5" FontWeight="SemiBold" />
                            <TextBox Text="{Binding Result, UpdateSourceTrigger=LostFocus}" Padding="9" MinHeight="64" AcceptsReturn="True" TextWrapping="Wrap" BorderBrush="{StaticResource LineBrush}" />
                            <TextBlock Text="Điều đã học hoặc đã hiểu" Margin="0,12,0,5" FontWeight="SemiBold" />
                            <TextBox Text="{Binding Learned, UpdateSourceTrigger=LostFocus}" Padding="9" MinHeight="64" AcceptsReturn="True" TextWrapping="Wrap" BorderBrush="{StaticResource LineBrush}" />
                            <TextBlock Text="Trở ngại" Margin="0,12,0,5" FontWeight="SemiBold" />
                            <TextBox Text="{Binding Blocker, UpdateSourceTrigger=LostFocus}" Padding="9" MinHeight="52" AcceptsReturn="True" TextWrapping="Wrap" BorderBrush="{StaticResource LineBrush}" />
                            <TextBlock Text="Bước tiếp theo" Margin="0,12,0,5" FontWeight="SemiBold" />
                            <TextBox Text="{Binding NextStep, UpdateSourceTrigger=LostFocus}" Padding="9" MinHeight="52" AcceptsReturn="True" TextWrapping="Wrap" BorderBrush="{StaticResource LineBrush}" />
                            <TextBlock Text="Cần có kết quả hoặc điều đã học để hoàn tất báo cáo." Margin="0,10,0,0" Foreground="{StaticResource MutedBrush}" />
                            <Button Content="Lưu báo cáo" Command="{Binding SaveReportCommand}" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Left" Margin="0,18,0,0" />
                        </StackPanel>
                        <Border Background="#F7F8F5" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="8" Padding="15" Margin="0,22,0,0">
                            <StackPanel>
                                <TextBlock Text="Ảnh minh chứng cho phiên (tùy chọn)" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" />
                                <TextBlock Text="PNG, JPG hoặc WebP · tối đa 5 MB mỗi ảnh" Margin="0,4,0,8" Foreground="{StaticResource MutedBrush}" />
                                <TextBox Text="{Binding EvidenceDescription, UpdateSourceTrigger=LostFocus}" Padding="8" ToolTip="Mô tả ảnh (tùy chọn)" BorderBrush="{StaticResource LineBrush}" />
                                <ListBox ItemsSource="{Binding EvidenceItems}" SelectedItem="{Binding SelectedEvidence, Mode=TwoWay}" MaxHeight="120" BorderThickness="0" Background="Transparent" Margin="0,8,0,4">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="White" CornerRadius="5" Padding="9" Margin="0,0,0,4">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding Description}" Margin="0,2,0,0" Foreground="{StaticResource MutedBrush}" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <Image Source="{Binding SelectedEvidence.AbsolutePath, Converter={StaticResource EvidencePreviewConverter}, IsAsync=True}"
                                       MaxHeight="240" MaxWidth="420" Stretch="Uniform" HorizontalAlignment="Left" Margin="0,8,0,0"
                                       Visibility="{Binding HasSelectedEvidence, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                <WrapPanel Margin="0,8,0,0">
                                    <Button Content="Thêm ảnh" Command="{Binding AddEvidenceCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,8" />
                                    <Button Content="Mở ảnh đã chọn" Command="{Binding OpenEvidenceCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,8" />
                                    <Button Content="Xóa ảnh đã chọn" Command="{Binding DeleteEvidenceCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,8" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
