<UserControl x:Class="PathForge.Desktop.Views.ProblemsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="34,30">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="18" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <DockPanel LastChildFill="False">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="Bài toán" FontSize="28" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" />
                <TextBlock Text="Làm rõ mục tiêu và giữ phạm vi giải quyết." Margin="0,5,0,0" Foreground="{StaticResource MutedBrush}" />
            </StackPanel>
            <Button DockPanel.Dock="Right" Content="＋  Tạo bài toán" Command="{Binding NewProblemCommand}" Style="{StaticResource PrimaryButtonStyle}" VerticalAlignment="Center" />
        </DockPanel>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="310" /><ColumnDefinition Width="18" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="10" Padding="14">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top">
                        <Button Content="Tìm" Command="{Binding SearchCommand}" Style="{StaticResource SecondaryButtonStyle}" DockPanel.Dock="Right" Margin="8,0,0,0" />
                        <TextBox Text="{Binding Keyword, UpdateSourceTrigger=PropertyChanged}" Padding="9" BorderBrush="{StaticResource LineBrush}" VerticalContentAlignment="Center" />
                    </DockPanel>
                    <Grid Margin="0,12,0,0">
                        <ListBox ItemsSource="{Binding Problems}" SelectedItem="{Binding SelectedProblem, Mode=TwoWay}"
                                 BorderThickness="0" Background="Transparent">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="11" Margin="0,0,0,6" Background="#F7F8F5" CornerRadius="7">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding Goal}" Margin="0,5,0,0" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" MaxHeight="44" />
                                            <TextBlock Text="{Binding StatusText}" Margin="0,6,0,0" FontSize="11" Foreground="{StaticResource AccentBrush}" />
                                            <TextBlock Text="{Binding UpdatedText}" Margin="0,3,0,0" FontSize="11" Foreground="{StaticResource MutedBrush}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock Text="{Binding EmptyListMessage}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="10,16,10,0"
                                   VerticalAlignment="Top" Visibility="{Binding HasProblems, Converter={StaticResource InverseVisibilityConverter}}" />
                    </Grid>
                </DockPanel>
            </Border>
            <Border Grid.Column="2" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="10" Padding="24">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Thông tin bài toán" FontSize="21" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" />
                        <TextBlock Text="Tên bài toán *" Margin="0,20,0,6" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" />
                        <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" Padding="10" BorderBrush="{StaticResource LineBrush}" />
                        <TextBlock Text="Mục tiêu cần đạt *" Margin="0,14,0,6" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" />
                        <TextBox Text="{Binding Goal, UpdateSourceTrigger=PropertyChanged}" Padding="10" MinHeight="72" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" BorderBrush="{StaticResource LineBrush}" />
                        <TextBlock Text="Mô tả hoặc điều kiện phạm vi" Margin="0,14,0,6" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" />
                        <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" Padding="10" MinHeight="62" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" BorderBrush="{StaticResource LineBrush}" />
                        <TextBlock Text="Tiêu chí thành công" Margin="0,14,0,6" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" />
                        <TextBox Text="{Binding SuccessCriteria, UpdateSourceTrigger=PropertyChanged}" Padding="10" MinHeight="62" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" BorderBrush="{StaticResource LineBrush}" />
                        <TextBlock Text="Bước tiếp theo" Margin="0,14,0,6" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" />
                        <TextBox Text="{Binding NextAction, UpdateSourceTrigger=PropertyChanged}" Padding="10" MinHeight="52" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" BorderBrush="{StaticResource LineBrush}" />
                        <CheckBox Content="Bài toán này bắt buộc có ảnh minh chứng khi hoàn thành" IsChecked="{Binding RequiresEvidence}" Margin="0,16,0,0" Foreground="{StaticResource InkBrush}" />
                        <TextBlock Text="{Binding ValidationMessage}" Margin="0,14,0,0" Foreground="#A33A32" TextWrapping="Wrap" />
                        <DockPanel Margin="0,18,0,0">
                            <Button Content="Lưu bài toán" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButtonStyle}" DockPanel.Dock="Left" />
                            <Button Content="Xóa" Command="{Binding DeleteCommand}" Style="{StaticResource SecondaryButtonStyle}" DockPanel.Dock="Right"
                                    Visibility="{Binding IsExisting, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        </DockPanel>
                        <Border Height="1" Background="{StaticResource LineBrush}" Margin="0,22,0,18" />
                        <TextBlock Text="Trạng thái" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" />
                        <TextBlock Text="{Binding StatusText}" Margin="0,5,0,10" Foreground="{StaticResource MutedBrush}" />
                        <WrapPanel>
                            <Button Content="Bắt đầu / tiếp tục" Command="{Binding MoveToInProgressCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,8"
                                    Visibility="{Binding IsExisting, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <Button Content="Đánh dấu bị chặn" Command="{Binding MoveToBlockedCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,8"
                                    Visibility="{Binding IsExisting, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <Button Content="Xác nhận hoàn thành" Command="{Binding ResolveCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,8"
                                    Visibility="{Binding IsExisting, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        </WrapPanel>
                        <Border Background="#F7F8F5" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="9" Padding="16" Margin="0,12,0,0"
                                Visibility="{Binding IsExisting, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel>
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Left">
                                        <TextBlock Text="Phân rã phạm vi" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" />
                                        <TextBlock Text="Tạo các câu hỏi hoặc kết quả nhỏ cần xử lý." Margin="0,4,0,0" Foreground="{StaticResource MutedBrush}" />
                                    </StackPanel>
                                    <Button Content="＋ Mục nhỏ" Command="{Binding NewScopeItemCommand}" Style="{StaticResource SecondaryButtonStyle}" DockPanel.Dock="Right" />
                                </DockPanel>
                                <ListBox ItemsSource="{Binding ScopeItems}" SelectedItem="{Binding SelectedScopeItem, Mode=TwoWay}"
                                         BorderThickness="0" Background="Transparent" Margin="0,12,0,4" MaxHeight="190">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="White" CornerRadius="6" Padding="10" Margin="0,0,0,5">
                                                <DockPanel>
                                                    <TextBlock Text="{Binding StatusText}" DockPanel.Dock="Right" Foreground="{StaticResource MutedBrush}" Margin="12,0,0,0" />
                                                    <TextBlock Text="{Binding Title}" TextWrapping="Wrap" Foreground="{StaticResource InkBrush}" />
                                                </DockPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <TextBlock Text="Mục tiêu nhỏ" Margin="0,10,0,5" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" />
                                <TextBox Text="{Binding ScopeTitle, UpdateSourceTrigger=PropertyChanged}" Padding="9" BorderBrush="{StaticResource LineBrush}" />
                                <TextBlock Text="Lý do hoặc ngữ cảnh (tùy chọn)" Margin="0,10,0,5" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" />
                                <TextBox Text="{Binding ScopeReason, UpdateSourceTrigger=PropertyChanged}" Padding="9" MinHeight="50" AcceptsReturn="True" TextWrapping="Wrap" BorderBrush="{StaticResource LineBrush}" />
                                <TextBlock Text="{Binding ScopeMessage}" Margin="0,8,0,0" Foreground="#A33A32" TextWrapping="Wrap" />
                                <WrapPanel Margin="0,12,0,0">
                                    <Button Content="Lưu mục" Command="{Binding SaveScopeItemCommand}" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,8" />
                                    <Button Content="Trong phạm vi" Command="{Binding ScopeInScopeCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,8" />
                                    <Button Content="Để sau" Command="{Binding ScopeBacklogCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,8" />
                                    <Button Content="Đã xử lý" Command="{Binding ScopeDoneCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,8" />
                                    <Button Content="Loại bỏ" Command="{Binding ScopeExcludedCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,8" />
                                    <Button Content="Xóa mục" Command="{Binding DeleteScopeItemCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,8" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                        <Border Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="9" Padding="16" Margin="0,12,0,0"
                                Visibility="{Binding IsExisting, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel>
                                <TextBlock Text="Ảnh minh chứng" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" />
                                <TextBlock Text="Ảnh được sao chép vào thư mục dữ liệu riêng của PathForge (tối đa 5 MB mỗi ảnh)." Margin="0,4,0,0" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                                <TextBox Text="{Binding EvidenceDescription, UpdateSourceTrigger=PropertyChanged}" Padding="9" Margin="0,12,0,0" ToolTip="Mô tả ảnh (tùy chọn)" BorderBrush="{StaticResource LineBrush}" />
                                <ListBox ItemsSource="{Binding EvidenceItems}" SelectedItem="{Binding SelectedEvidence, Mode=TwoWay}"
                                         BorderThickness="0" Background="Transparent" Margin="0,10,0,4" MaxHeight="150">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#F7F8F5" CornerRadius="6" Padding="10" Margin="0,0,0,5">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" />
                                                    <TextBlock Text="{Binding Description}" Margin="0,3,0,0" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <TextBlock Text="{Binding EvidenceMessage}" Foreground="#A33A32" TextWrapping="Wrap" />
                                <WrapPanel Margin="0,10,0,0">
                                    <Button Content="Thêm ảnh" Command="{Binding AddEvidenceCommand}" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,8" />
                                    <Button Content="Mở ảnh đã chọn" Command="{Binding OpenEvidenceCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,8" />
                                    <Button Content="Xóa ảnh đã chọn" Command="{Binding DeleteEvidenceCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,8" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                        <Border Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="9" Padding="16" Margin="0,12,0,0"
                                Visibility="{Binding IsExisting, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel>
                                <TextBlock Text="Các phiên gần đây" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" />
                                <ListBox ItemsSource="{Binding RecentWorkLogs}" SelectedItem="{Binding SelectedWorkLog, Mode=TwoWay}"
                                         BorderThickness="0" Background="Transparent" Margin="0,8,0,4" MaxHeight="180">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#F7F8F5" CornerRadius="6" Padding="10" Margin="0,0,0,5">
                                                <StackPanel>
                                                    <DockPanel>
                                                        <TextBlock Text="{Binding StatusText}" DockPanel.Dock="Right" Foreground="{StaticResource MutedBrush}" Margin="10,0,0,0" />
                                                        <TextBlock Text="{Binding TaskTitle}" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" TextWrapping="Wrap" />
                                                    </DockPanel>
                                                    <TextBlock Text="{Binding Summary}" Margin="0,4,0,0" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" MaxHeight="40" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <Button Content="Mở báo cáo phiên đã chọn" Command="{Binding OpenWorkLogCommand}" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Left" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
