<UserControl x:Class="PathForge.Desktop.Views.ProblemsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="30,26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="22" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <DockPanel LastChildFill="False">
            <StackPanel>
                <TextBlock Text="Bài toán" FontSize="29" FontWeight="SemiBold" />
                <TextBlock Text="Xác định điều cần giải quyết, mục tiêu và bước tiếp theo." Margin="0,5,0,0" Foreground="{StaticResource MutedBrush}" />
            </StackPanel>
            <Button DockPanel.Dock="Right" Content="＋  Tạo bài toán" Command="{Binding NewProblemCommand}"
                    Style="{StaticResource PrimaryButtonStyle}" VerticalAlignment="Center" />
        </DockPanel>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="12" Padding="14">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="Danh sách" FontSize="17" FontWeight="SemiBold" Margin="2,0,0,10" />
                        <DockPanel LastChildFill="False">
                            <Button Content="Tìm" Command="{Binding SearchCommand}" Style="{StaticResource SecondaryButtonStyle}"
                                    DockPanel.Dock="Right" Margin="8,0,0,0" Padding="12,7" />
                            <TextBox Text="{Binding Keyword, UpdateSourceTrigger=PropertyChanged}" ToolTip="Tìm theo tên hoặc mục tiêu"
                                     Padding="10,7" MinHeight="38" />
                        </DockPanel>
                    </StackPanel>
                    <Grid Margin="0,12,0,0">
                        <ListBox ItemsSource="{Binding Problems}" SelectedItem="{Binding SelectedProblem, Mode=TwoWay}"
                                 BorderThickness="0" Background="Transparent" ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="13" Margin="0,0,0,7" Background="#F6F8F6" BorderBrush="{StaticResource LineBrush}"
                                            BorderThickness="1" CornerRadius="9">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding Goal}" Margin="0,5,0,0" Foreground="{StaticResource MutedBrush}"
                                                       TextWrapping="Wrap" MaxHeight="42" />
                                            <DockPanel Margin="0,9,0,0">
                                                <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" FontSize="11" />
                                                <TextBlock Text="{Binding UpdatedText}" DockPanel.Dock="Right" Foreground="{StaticResource MutedBrush}" FontSize="11" />
                                            </DockPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <StackPanel Visibility="{Binding HasProblems, Converter={StaticResource InverseVisibilityConverter}}"
                                    Margin="12,24,12,0" VerticalAlignment="Top">
                            <TextBlock Text="{Binding EmptyListMessage}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                            <Button Content="＋ Tạo bài toán" Command="{Binding NewProblemCommand}" Style="{StaticResource SecondaryButtonStyle}"
                                    HorizontalAlignment="Left" Margin="0,12,0,0" />
                        </StackPanel>
                    </Grid>
                </DockPanel>
            </Border>

            <Border Grid.Column="2" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="12" Padding="22">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="14" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <DockPanel LastChildFill="False">
                        <StackPanel>
                            <TextBlock Text="Thông tin bài toán" FontSize="20" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding EditorModeText}" Margin="0,4,0,0" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                        <Border Background="{StaticResource AccentSoftBrush}" CornerRadius="12" Padding="10,4" DockPanel.Dock="Right"
                                VerticalAlignment="Center" Visibility="{Binding IsExisting, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" FontSize="12" />
                        </Border>
                    </DockPanel>

                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="0,0,7,4">
                            <TextBlock Text="MỤC TIÊU VÀ BỐI CẢNH" FontSize="11" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,9" />
                            <TextBlock Text="Tên bài toán *" Margin="0,4,0,5" FontWeight="SemiBold" />
                            <TextBox Text="{Binding Title, UpdateSourceTrigger=LostFocus}" />
                            <TextBlock Text="Mục tiêu cần đạt *" Margin="0,14,0,5" FontWeight="SemiBold" />
                            <TextBox Text="{Binding Goal, UpdateSourceTrigger=LostFocus}" MinHeight="72" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
                            <TextBlock Text="Mô tả hoặc điều kiện phạm vi" Margin="0,14,0,5" FontWeight="SemiBold" />
                            <TextBox Text="{Binding Description, UpdateSourceTrigger=LostFocus}" MinHeight="62" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />

                            <Border Height="1" Background="{StaticResource LineBrush}" Margin="0,22,0,18" />
                            <TextBlock Text="PHÂN TÍCH 5W–1H" FontSize="11" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" />
                            <TextBlock Text="Bổ sung những thông tin đã biết; bạn có thể để trống phần chưa rõ." Margin="0,4,0,7" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                            <TextBlock Text="What · Vấn đề hoặc kết quả cần đạt" Margin="0,8,0,5" FontWeight="SemiBold" />
                            <TextBox Text="{Binding AnalysisWhat, UpdateSourceTrigger=LostFocus}" MinHeight="48" AcceptsReturn="True" TextWrapping="Wrap" />
                            <TextBlock Text="Why · Lý do cần giải quyết" Margin="0,10,0,5" FontWeight="SemiBold" />
                            <TextBox Text="{Binding AnalysisWhy, UpdateSourceTrigger=LostFocus}" MinHeight="48" AcceptsReturn="True" TextWrapping="Wrap" />
                            <TextBlock Text="Who · Người hoặc đối tượng liên quan" Margin="0,10,0,5" FontWeight="SemiBold" />
                            <TextBox Text="{Binding AnalysisWho, UpdateSourceTrigger=LostFocus}" MinHeight="48" AcceptsReturn="True" TextWrapping="Wrap" />
                            <TextBlock Text="Where · Bối cảnh hoặc môi trường" Margin="0,10,0,5" FontWeight="SemiBold" />
                            <TextBox Text="{Binding AnalysisWhere, UpdateSourceTrigger=LostFocus}" MinHeight="48" AcceptsReturn="True" TextWrapping="Wrap" />
                            <TextBlock Text="When · Thời điểm hoặc điều kiện xảy ra" Margin="0,10,0,5" FontWeight="SemiBold" />
                            <TextBox Text="{Binding AnalysisWhen, UpdateSourceTrigger=LostFocus}" MinHeight="48" AcceptsReturn="True" TextWrapping="Wrap" />
                            <TextBlock Text="How · Hướng tiếp cận hoặc giả thuyết ban đầu" Margin="0,10,0,5" FontWeight="SemiBold" />
                            <TextBox Text="{Binding AnalysisHow, UpdateSourceTrigger=LostFocus}" MinHeight="48" AcceptsReturn="True" TextWrapping="Wrap" />
                            <TextBlock Text="Tiêu chí thành công" Margin="0,14,0,5" FontWeight="SemiBold" />
                            <TextBox Text="{Binding SuccessCriteria, UpdateSourceTrigger=LostFocus}" MinHeight="62" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
                            <TextBlock Text="Bước tiếp theo" Margin="0,14,0,5" FontWeight="SemiBold" />
                            <TextBox Text="{Binding NextAction, UpdateSourceTrigger=LostFocus}" MinHeight="52" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
                            <CheckBox Content="Yêu cầu ảnh minh chứng khi hoàn thành" IsChecked="{Binding RequiresEvidence}" Margin="0,16,0,0" />

                            <Border Height="1" Background="{StaticResource LineBrush}" Margin="0,22,0,18"
                                    Visibility="{Binding IsExisting, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <StackPanel Visibility="{Binding IsExisting, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Text="TRẠNG THÁI" FontSize="11" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" />
                                <WrapPanel Margin="0,10,0,0">
                                    <Button Content="Bắt đầu / tiếp tục" Command="{Binding MoveToInProgressCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,8" />
                                    <Button Content="Đánh dấu bị chặn" Command="{Binding MoveToBlockedCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,8" />
                                    <Button Content="Xác nhận hoàn thành" Command="{Binding ResolveCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,8" />
                                </WrapPanel>
                            </StackPanel>

                            <Border Background="#F5F8F6" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,12,0,0"
                                    Visibility="{Binding IsExisting, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <StackPanel>
                                    <DockPanel>
                                        <StackPanel>
                                            <TextBlock Text="Phân rã phạm vi" FontSize="17" FontWeight="SemiBold" />
                                            <TextBlock Text="Chia bài toán thành câu hỏi hoặc kết quả nhỏ." Margin="0,4,0,0" Foreground="{StaticResource MutedBrush}" />
                                        </StackPanel>
                                        <Button Content="＋ Mục nhỏ" Command="{Binding NewScopeItemCommand}" Style="{StaticResource SecondaryButtonStyle}" DockPanel.Dock="Right" />
                                    </DockPanel>
                                    <ListBox ItemsSource="{Binding ScopeItems}" SelectedItem="{Binding SelectedScopeItem, Mode=TwoWay}"
                                             BorderThickness="0" Background="Transparent" Margin="0,12,0,4" MaxHeight="190">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="White" CornerRadius="7" Padding="11" Margin="0,0,0,6">
                                                    <DockPanel>
                                                        <TextBlock Text="{Binding StatusText}" DockPanel.Dock="Right" Foreground="{StaticResource MutedBrush}" Margin="12,0,0,0" />
                                                        <TextBlock Text="{Binding Title}" TextWrapping="Wrap" />
                                                    </DockPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <TextBlock Text="Mục tiêu nhỏ" Margin="0,10,0,5" FontWeight="SemiBold" />
                                    <TextBox Text="{Binding ScopeTitle, UpdateSourceTrigger=LostFocus}" />
                                    <TextBlock Text="Lý do hoặc ngữ cảnh (tùy chọn)" Margin="0,10,0,5" FontWeight="SemiBold" />
                                    <TextBox Text="{Binding ScopeReason, UpdateSourceTrigger=LostFocus}" MinHeight="50" AcceptsReturn="True" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding ScopeMessage}" Margin="0,8,0,0" Foreground="#A33A32" TextWrapping="Wrap" />
                                    <WrapPanel Margin="0,12,0,0">
                                        <Button Content="Lưu mục" Command="{Binding SaveScopeItemCommand}" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,8" />
                                        <Button Content="Trong phạm vi" Command="{Binding ScopeInScopeCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,8" />
                                        <Button Content="Để sau" Command="{Binding ScopeBacklogCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,8" />
                                        <Button Content="Đã xử lý" Command="{Binding ScopeDoneCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,8" />
                                        <Button Content="Loại bỏ" Command="{Binding ScopeExcludedCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,8" />
                                        <Button Content="Xóa mục" Command="{Binding DeleteScopeItemCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,8" />
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <Border Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,12,0,0"
                                    Visibility="{Binding IsExisting, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <StackPanel>
                                    <TextBlock Text="Ảnh minh chứng" FontSize="17" FontWeight="SemiBold" />
                                    <TextBlock Text="Ảnh được lưu cùng dữ liệu riêng của PathForge · tối đa 5 MB mỗi ảnh." Margin="0,4,0,0" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                                    <TextBox Text="{Binding EvidenceDescription, UpdateSourceTrigger=LostFocus}" Margin="0,12,0,0" ToolTip="Mô tả ảnh (tùy chọn)" />
                                    <ListBox ItemsSource="{Binding EvidenceItems}" SelectedItem="{Binding SelectedEvidence, Mode=TwoWay}"
                                             BorderThickness="0" Background="Transparent" Margin="0,10,0,4" MaxHeight="150">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#F6F8F6" CornerRadius="7" Padding="10" Margin="0,0,0,5">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                                                        <TextBlock Text="{Binding Description}" Margin="0,3,0,0" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <TextBlock Text="{Binding EvidenceMessage}" Foreground="#A33A32" TextWrapping="Wrap" />
                                    <Image Source="{Binding SelectedEvidence.AbsolutePath, Converter={StaticResource EvidencePreviewConverter}}"
                                           MaxHeight="240" MaxWidth="420" Stretch="Uniform" HorizontalAlignment="Left" Margin="0,8,0,0"
                                           Visibility="{Binding HasSelectedEvidence, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    <WrapPanel Margin="0,10,0,0">
                                        <Button Content="Thêm ảnh" Command="{Binding AddEvidenceCommand}" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,8" />
                                        <Button Content="Mở ảnh đã chọn" Command="{Binding OpenEvidenceCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,8" />
                                        <Button Content="Xóa ảnh đã chọn" Command="{Binding DeleteEvidenceCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,8" />
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <Border Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,12,0,0"
                                    Visibility="{Binding IsExisting, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <StackPanel>
                                    <TextBlock Text="Các phiên gần đây" FontSize="17" FontWeight="SemiBold" />
                                    <ListBox ItemsSource="{Binding RecentWorkLogs}" SelectedItem="{Binding SelectedWorkLog, Mode=TwoWay}"
                                             BorderThickness="0" Background="Transparent" Margin="0,8,0,4" MaxHeight="180">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#F6F8F6" CornerRadius="7" Padding="10" Margin="0,0,0,5">
                                                    <StackPanel>
                                                        <DockPanel>
                                                            <TextBlock Text="{Binding StatusText}" DockPanel.Dock="Right" Foreground="{StaticResource MutedBrush}" Margin="10,0,0,0" />
                                                            <TextBlock Text="{Binding TaskTitle}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                        </DockPanel>
                                                        <TextBlock Text="{Binding Summary}" Margin="0,4,0,0" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" MaxHeight="40" />
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <Button Content="Mở báo cáo phiên đã chọn" Command="{Binding OpenWorkLogCommand}" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Left" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <Border Grid.Row="3" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="0,14,0,0" Margin="0,10,0,0">
                        <DockPanel LastChildFill="False">
                            <TextBlock Text="{Binding ValidationMessage}" Foreground="#A33A32" TextWrapping="Wrap" VerticalAlignment="Center" MaxWidth="430" />
                            <WrapPanel DockPanel.Dock="Right" HorizontalAlignment="Right">
                                <Button Content="Xóa" Command="{Binding DeleteCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0"
                                        Visibility="{Binding IsExisting, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                <Button Content="＋ Tạo bài toán mới" Command="{Binding NewProblemCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0"
                                        Visibility="{Binding IsExisting, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                <Button Content="{Binding SaveButtonText}" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButtonStyle}" />
                            </WrapPanel>
                        </DockPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
